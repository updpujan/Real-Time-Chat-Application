{
  "name": "real-time-chat-application",
  "version": "1.0.0",
  "description": "Real-time chat application using Node.js, TypeScript, Express and WebSocket and PostgreSQL",
  "scripts": {
    "dev": "tsx watch ./src/server.ts",
    "build": "tsc",
    "start": "node ./dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "migration:status": "node scripts/sequelize-cli.cjs db:migrate:status",
    "migration:run": "node scripts/sequelize-cli.cjs db:migrate",
    "migration:revert": "node scripts/sequelize-cli.cjs db:migrate:undo",
    "migration:status:prod": "sequelize-cli db:migrate:status --migrations-path dist/migrations",
    "migration:run:prod": "sequelize-cli db:migrate --migrations-path dist/migrations",
    "migration:revert:prod": "sequelize-cli db:migrate:undo --migrations-path dist/migrations"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/updpujan/Real-Time-Chat-Application.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/updpujan/Real-Time-Chat-Application/issues"
  },
  "homepage": "https://github.com/updpujan/Real-Time-Chat-Application#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-session-sequelize": "^8.0.6",
    "dotenv": "^18.0.4",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "sequelize-cli": "^6.6.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@scarf/scarf@1.4.0": true,
    "bcrypt@6.0.0": true
  }
}
